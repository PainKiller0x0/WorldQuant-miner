[Unit]
Description=WorldQuant Miner Rust check and submission reconciler
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/worldquant-miner
EnvironmentFile=/root/worldquant-miner/.env
Environment=WQ_ROOT=/root/worldquant-miner
Environment=WQ_TPM=5
ExecStart=/usr/local/bin/worldquant-miner-rs submit --limit 10 --auto-submit
